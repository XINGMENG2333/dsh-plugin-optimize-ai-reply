{
  "manifest_version": 3,
  "name": "优化 AI 回复 · Optimize AI Reply",
  "version": "2.4.1",
  "description": "把大模型输出改成读起来像人写的：本地密度扫描（零网络）+ 只改命中项 + 事实/强度/安全三层校验 + 闭环复扫，不达标自动回退原文。",
  "default_locale": null,
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://api.deepseek.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://*.moonshot.cn/*",
    "https://*.aliyuncs.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/ui/popup.html",
    "default_title": "优化 AI 回复 · Optimize AI Reply"
  },
  "side_panel": {
    "default_path": "src/ui/panel.html"
  },
  "options_page": "src/ui/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://www.kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://www.tongyi.com/*",
        "https://tongyi.aliyun.com/*",
        "https://www.doubao.com/*",
        "https://doubao.com/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
